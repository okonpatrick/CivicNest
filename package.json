{
  "name": "civicnest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "boundaries": "node scripts/check-boundaries.cjs",
    "format": "prettier --write \"**/*.{js,ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,css,json,md}\"",
    "test": "vitest run",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "check": "pnpm lint && pnpm boundaries && pnpm test && pnpm format:check && pnpm build"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "jsdom": "^26.1.0",
    "prettier": "3.10.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.73.0",
    "vite": "^7.3.2",
    "vitest": "^3.2.4"
  }
}
