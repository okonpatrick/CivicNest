{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@civicnest/design-tokens": ["packages/design-tokens/index.ts"],
      "@civicnest/ui": ["packages/ui/index.tsx"],
      "@civicnest/utils": ["packages/utils/index.ts"],
      "@civicnest/resident-support": ["services/resident-support/index.tsx"],
      "@civicnest/permits": ["services/permits/index.tsx"],
      "@civicnest/community-services": ["services/community-services/index.tsx"]
    }
  },
  "include": ["src", "packages", "services", "vite.config.ts"]
}
